# Config for the Playwright suite's own frontend. Loaded automatically by
# Vite when playwright.config.js starts it with `--mode test` (Vite's own
# convention: .env.<mode> layers over .env) -- see frontend/playwright.config.js.
#
# Copy this to frontend/.env.test and it works as-is. Dedicated ports (3100 /
# 9100, not the dev server's 3000 / 9000) so the e2e stack can never be
# mistaken for -- or collide with -- a dev stack you already have running.
# Both numbers are also hardcoded in playwright.config.js as
# E2E_FRONTEND_PORT/E2E_BACKEND_PORT and in backend/.env.test's
# CSRF_TRUSTED_ORIGINS -- change all three together.

FRONTEND_PORT=3100
BACKEND_URL=http://localhost:9100
