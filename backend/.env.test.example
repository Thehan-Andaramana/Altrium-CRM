# Config for the Playwright suite's own backend, loaded instead of .env when
# DJANGO_ENV_FILE=.env.test (see frontend/e2e/global-setup.js and
# frontend/playwright.config.js, which both set that before every command).
#
# Copy this to backend/.env.test and it works as-is against the same
# Postgres container docker-compose already brings up -- altrium_e2e is a
# separate *database* on that same server, not a separate container, created
# on demand by `manage.py ensure_database` (see frontend/e2e/global-setup.js,
# or run it by hand -- see the README's End-to-end tests section).

DEBUG=True
SECRET_KEY=dev-only-not-for-production

# Same host/port as backend/.env's Postgres (DB_PORT there), different
# database name -- this is what keeps e2e runs off the `altrium` database
# entirely. If you changed DB_PORT in the root .env, change it here too.
DATABASE_URL=postgres://altrium:altrium@localhost:5432/altrium_e2e
DB_PORT=5432

# The e2e frontend runs on its own port (3100, not the dev server's 3000 --
# see frontend/.env.test.example) precisely so it's never the dev stack by
# accident. Both numbers are also hardcoded in frontend/playwright.config.js
# as E2E_BACKEND_PORT/E2E_FRONTEND_PORT -- change all three together.
CSRF_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
