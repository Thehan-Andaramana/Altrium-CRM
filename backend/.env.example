# Django
DEBUG=True
SECRET_KEY=replace-with-a-50-character-random-string

# Host port for Postgres. Change if 5432 is taken on your machine.
DB_PORT=5432

# Database — matches the db service in docker-compose.yml
DATABASE_URL=postgres://altrium:altrium@localhost:5432/altrium

# Origins allowed to make unsafe requests (comma-separated). Defaults to the
# React dev server ports if unset.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
