{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Database (Docker)",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "altrium",
        "reveal": "always"
      }
    },
    {
      "label": "2. Backend (Django)",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python manage.py runserver 9000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Performing system checks",
          "endsPattern": "Starting .*development server at"
        }
      },
      "presentation": { "panel": "dedicated", "group": "altrium", "reveal": "always" }
    },
    {
      "label": "3. Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": { "panel": "dedicated", "group": "altrium", "reveal": "always" }
    },
    {
      "label": "Start Altrium CRM",
      "type": "shell",
      "command": "Write-Host ''; Write-Host '  Altrium CRM is starting' -ForegroundColor Yellow; Write-Host ''; Write-Host '  Frontend    http://localhost:3000'; Write-Host '  Django admin  http://127.0.0.1:9000/admin'; Write-Host '  API docs      http://127.0.0.1:9000/api/docs'; Write-Host ''; Write-Host '  Login: rep1 / mgr1  password testpass123' -ForegroundColor DarkGray; Write-Host ''",
      "dependsOrder": "sequence",
      "dependsOn": [
        "1. Database (Docker)",
        "2. Backend (Django)",
        "3. Frontend (Vite)"
      ],
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Stop database",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run backend tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python manage.py test crm",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Apply migrations",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python manage.py makemigrations; python manage.py migrate",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Seed demo data",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\Activate.ps1; python manage.py seed_demo",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Reset database (DESTRUCTIVE)",
      "type": "shell",
      "command": "docker compose down -v; docker compose up -d; Start-Sleep -Seconds 5; cd backend; .\\.venv\\Scripts\\Activate.ps1; python manage.py migrate; python manage.py seed_demo",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}