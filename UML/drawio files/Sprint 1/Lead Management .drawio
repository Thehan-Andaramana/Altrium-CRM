        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\ntitle sd Lead Management (Add, Update, View)\n\nactor \&quot;Sales Rep / Sales Manager /\\nExecutive Manager\&quot; as User\nparticipant \&quot;Browser (React)\&quot; as Browser\nparticipant \&quot;Django REST API\&quot; as API\nparticipant \&quot;PostgreSQL\&quot; as DB\n\nUser -&gt; Browser: 1. openPipeline()\nBrowser -&gt; API: 2. GET /api/leads/?search={query}\nAPI -&gt; DB: 3. SELECT non-archived leads\\n(Sales Rep: only assigned leads)\nDB --&gt; API: 4. lead rows\nAPI --&gt; Browser: 5. 200 OK (leads)\nBrowser --&gt; User: 6. show pipeline list\n\nUser -&gt; Browser: 7. createLead(name, company, contact, rep)\nBrowser -&gt; API: 8. POST /api/leads/\nAPI -&gt; API: 9. validate: rep only on own companies;\\nlead must be assigned to a Sales Rep\n\nalt valid\n    API -&gt; DB: 10. INSERT lead\n    API -&gt; DB: 11. INSERT project (Phase 1 IN_PROGRESS), copy active\\ntemplates as tasks, set Phase 1 due dates\n    DB --&gt; API: 12. saved\n    API --&gt; Browser: 13. 201 Created\n    Browser --&gt; User: 14. open lead with Phase 1 tasks\nelse invalid\n    API --&gt; Browser: 15. 400 Bad Request (validation message)\n    Browser --&gt; User: 16. show error\nend\n\nUser -&gt; Browser: 17. updateLead(leadId, changes)\nBrowser -&gt; API: 18. PATCH /api/leads/{id}/\nAPI -&gt; DB: 19. UPDATE lead + INSERT ActivityEvent\\n(Lead updated: ...)\nDB --&gt; API: 20. saved\nAPI --&gt; Browser: 21. 200 OK\nBrowser --&gt; User: 22. show updated lead\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="eNon-5TYNhqSSjkX8qhA-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
