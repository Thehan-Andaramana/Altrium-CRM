        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\ntitle sd Lead Archive\n\nactor \&quot;Sales Representative\&quot; as Rep\nactor \&quot;Sales Manager /\\nExecutive Manager\&quot; as Mgr\nparticipant \&quot;Browser (React)\&quot; as Browser\nparticipant \&quot;Django REST API\&quot; as API\nparticipant \&quot;PostgreSQL\&quot; as DB\n\nRep -&gt; Browser: 1. requestArchive(lead, reason)\nBrowser -&gt; API: 2. POST /api/approvals/ {ARCHIVE_LEAD, lead, reason}\nAPI -&gt; API: 3. check lead is assigned to requester\nAPI -&gt; DB: 4. INSERT ApprovalRequest (PENDING)\\n+ ActivityEvent (Archive requested)\nDB --&gt; API: 5. saved\nAPI --&gt; Browser: 6. 201 Created\nBrowser --&gt; Rep: 7. show Archive requested (lead stays active)\n\nMgr -&gt; Browser: 8. approve / reject request\nBrowser -&gt; API: 9. PATCH /api/approvals/{id}/ {status}\nAPI -&gt; API: 10. check management role and\\napprover is not the requester\n\nalt APPROVED\n    API -&gt; DB: 11. UPDATE request APPROVED; archive lead\\nwith the request reason + ActivityEvent\nelse REJECTED\n    API -&gt; DB: 12. UPDATE request REJECTED (lead unchanged)\nend\nDB --&gt; API: 13. saved\nAPI --&gt; Browser: 14. 200 OK\nBrowser --&gt; Mgr: 15. show decision\n\nMgr -&gt; Browser: 16. archiveLead(lead, reason)\nBrowser -&gt; API: 17. POST /api/leads/{id}/archive/ {archive_reason}\n\nalt reason given\n    API -&gt; DB: 18. UPDATE lead is_archived=true\\n+ ActivityEvent (Lead archived)\n    DB --&gt; API: 19. saved\n    API --&gt; Browser: 20. 200 OK\n    Browser --&gt; Mgr: 21. remove lead from pipeline\nelse reason blank\n    API --&gt; Browser: 22. 400 Bad Request (reason required)\n    Browser --&gt; Mgr: 23. show error\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="eNon-5TYNhqSSjkX8qhA-37">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
